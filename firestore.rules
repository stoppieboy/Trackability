rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(partnershipId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.memberIds;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId && !('partnershipId' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == userId
                    && request.resource.data.partnershipId == resource.data.partnershipId;
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if false; // The callable function consumes a valid code atomically.
    }
    match /partnerships/{partnershipId} {
      allow read: if isMember(partnershipId);
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMember(partnershipId);
      match /habits/{habitId} { allow read, write: if isMember(partnershipId); }
      match /completions/{completionId} { allow read, write: if isMember(partnershipId); }
    }
  }
}
